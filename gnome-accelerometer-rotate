#!/usr/bin/env bash
set -u

LOCK_SCHEMA='org.gnome.settings-daemon.peripherals.touchscreen'
LOCK_KEY='orientation-lock'
OSK_SCHEMA='org.gnome.desktop.a11y.applications'
OSK_KEY='screen-keyboard-enabled'
BUILTIN='eDP-1'

log() {
    printf '[gnome-accelerometer-rotate] %s\n' "$*"
}

is_locked() {
    [[ "$(gsettings get "$LOCK_SCHEMA" "$LOCK_KEY")" == "true" ]]
}

get_orientation() {
    timeout 2s monitor-sensor 2>&1 |
        sed -n 's/.*Has accelerometer (orientation: \([^,)]*\).*/\1/p' |
        head -n1
}

desired_transform() {
    case "$1" in
        normal)    echo normal ;;
        left-up)   echo 90 ;;
        bottom-up) echo 180 ;;
        right-up)  echo 270 ;;
        *)         return 1 ;;
    esac
}

current_transform() {
    gdctl show |
        awk -v target="$BUILTIN" '
            /Logical monitor #[0-9]+/ {
                transform=""
                found=0
            }

            /Transform:/ {
                line=$0
                sub(/^.*Transform: /, "", line)
                transform=line
            }

            index($0, target " (Built-in display)") {
                found=1
            }

            found && transform != "" {
                print transform
                exit
            }
        '
}

external_keyboard_present() {
    local dev props bus

    for dev in /dev/input/event*; do
        props="$(udevadm info --query=property --name="$dev" 2>/dev/null)" ||
            continue

        grep -qx 'ID_INPUT_KEYBOARD=1' <<<"$props" || continue

        bus="$(sed -n 's/^ID_BUS=//p' <<<"$props" | head -n1)"

        if [[ -n "$bus" && "$bus" != "i8042" ]]; then
            return 0
        fi
    done

    return 1
}

sync_osk() {
    local transform current desired=false

    transform="$(current_transform)"

    if [[ -n "$transform" && "$transform" != "normal" ]] &&
       ! external_keyboard_present; then
        desired=true
    fi

    current="$(gsettings get "$OSK_SCHEMA" "$OSK_KEY")"

    if [[ "$current" == "$desired" ]]; then
        return
    fi

    gsettings set "$OSK_SCHEMA" "$OSK_KEY" "$desired"
    log "screen keyboard enabled=$desired transform=${transform:-unknown}"
}

apply_transform() {
    local desired="$1"
    local -a cmd=(gdctl set)

    # Convert the current logical-monitor configuration reported by gdctl
    # back into a complete gdctl set command, changing only BUILTIN transform.
    while IFS='|' read -r connector scale transform primary x y; do
        [[ -z "$connector" ]] && continue

        if [[ "$connector" == "$BUILTIN" ]]; then
            transform="$desired"
        fi

        cmd+=(--logical-monitor
             --monitor "$connector"
             --scale "$scale"
             --transform "$transform"
             --x "$x"
             --y "$y")

        if [[ "$primary" == "yes" ]]; then
            cmd+=(--primary)
        fi
    done < <(
        gdctl show | awk '
            /Logical monitor #[0-9]+/ {
                if (connector != "")
                    print connector "|" scale "|" transform "|" primary "|" x "|" y

                connector=""
                scale=""
                transform=""
                primary=""
                x=""
                y=""
                inlogical=1
                next
            }

            inlogical && /Position:/ {
                line=$0
                sub(/^.*Position: \(/, "", line)
                sub(/\).*$/, "", line)
                split(line, p, /, */)
                x=p[1]
                y=p[2]
            }

            inlogical && /Scale:/ {
                line=$0
                sub(/^.*Scale: /, "", line)
                scale=line
            }

            inlogical && /Transform:/ {
                line=$0
                sub(/^.*Transform: /, "", line)
                transform=line
            }

            inlogical && /Primary:/ {
                line=$0
                sub(/^.*Primary: /, "", line)
                primary=line
            }

            inlogical && /└──[A-Za-z0-9.-]+/ {
                line=$0
                sub(/^.*└──/, "", line)
                sub(/ .*/, "", line)
                connector=line
            }

            END {
                if (connector != "")
                    print connector "|" scale "|" transform "|" primary "|" x "|" y
            }
        '
    )

    "${cmd[@]}"
}

sync_orientation() {
    if is_locked; then
        log "rotation locked; ignoring"
        return
    fi

    local orientation desired current

    # Sensor events already know the current orientation. Startup and
    # unlocking query it explicitly.
    orientation="${1:-}"
    if [[ -z "$orientation" ]]; then
        orientation="$(get_orientation)"
    fi

    if ! desired="$(desired_transform "$orientation")"; then
        log "unknown sensor orientation: ${orientation:-unset}"
        return
    fi

    current="$(current_transform)"

    log "sensor=$orientation desired=$desired current=${current:-unknown}"

    if [[ "$current" == "$desired" ]]; then
        log "already synchronized"
        sync_osk
        return
    fi

    if apply_transform "$desired"; then
        log "rotated to $desired"
        sync_osk
    else
        log "ERROR: gdctl failed to apply transform"
    fi
}

sensor_watch() {
    monitor-sensor 2>&1 |
        while IFS= read -r line; do
            case "$line" in
                *"Accelerometer orientation changed:"*)
                    orientation="${line##*: }"
                    log "$line"
                    sync_orientation "$orientation"
                    ;;
            esac
        done
}

lock_watch() {
    gsettings monitor "$LOCK_SCHEMA" "$LOCK_KEY" |
        while IFS= read -r line; do
            log "orientation-lock changed: $line"

            if ! is_locked; then
                log "rotation unlocked; synchronizing now"
                sync_orientation
            fi
        done
}

keyboard_watch() {
    udevadm monitor --udev --subsystem-match=input 2>/dev/null |
        while IFS= read -r line; do
            case "$line" in
                *" add "*|*" remove "*)
                    sync_osk
                    ;;
            esac
        done
}

cleanup() {
    [[ -n "${sensor_pid:-}" ]] && kill "$sensor_pid" 2>/dev/null || true
    [[ -n "${lock_pid:-}" ]] && kill "$lock_pid" 2>/dev/null || true
    [[ -n "${keyboard_pid:-}" ]] && kill "$keyboard_pid" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

log "starting"
log "initial orientation-lock=$(gsettings get "$LOCK_SCHEMA" "$LOCK_KEY")"

if ! is_locked; then
    sync_orientation
else
    sync_osk
fi

sensor_watch &
sensor_pid=$!

lock_watch &
lock_pid=$!

keyboard_watch &
keyboard_pid=$!

wait
